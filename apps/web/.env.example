# Copy to .env and fill in. Never commit .env.

# Web database (pandora_web) — NOT the rAthena game DB
DATABASE_URL="mysql://root:password@127.0.0.1:3306/pandora_web"

# Public site URL (used for SEO canonical / OG / sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Google OAuth  (https://console.cloud.google.com/apis/credentials)
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Discord OAuth (https://discord.com/developers/applications)
# Redirect URI: http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
# Server (guild) players are invited to, and the bot that adds them (week 2)
DISCORD_GUILD_ID=""
DISCORD_BOT_TOKEN=""
# Optional: role given to pre-registered players
DISCORD_PREREG_ROLE_ID=""

# Meta Conversions API (server-side). Pixel ID itself is set in admin → Settings.
META_CAPI_TOKEN=""
# Optional: shows events in Events Manager → Test events
META_CAPI_TEST_CODE=""

# Cloudflare Turnstile bot check on sign-up (https://dash.cloudflare.com → Turnstile).
# Leave empty to disable (local dev). Cloudflare test keys that always pass:
#   site 1x00000000000000000000AA  /  secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Where admin-uploaded images are stored (served at /media/...). Default: ./uploads
# In production, point this at a persistent volume so uploads survive redeploys.
UPLOAD_DIR=""
